NODE_ENV=production
# Environment label for Sentry and alert emails (NODE_ENV is production in both).
APP_ENV=staging
PORT=4001
API_HOST=127.0.0.1
API_BASE_URL=https://api-gem-dev.aidanlenahan.com
WEB_BASE_URL=https://gem-dev.aidanlenahan.com
WEB_ALLOWED_ORIGINS=https://gem-dev.aidanlenahan.com

DATABASE_URL=postgresql://gem:<replace-password>@127.0.0.1:5432/gem_staging
REDIS_URL=redis://127.0.0.1:6379/1

# Generate a separate secret from prod: openssl rand -hex 32
AUTH_SECRET=<strong-random-secret-different-from-prod>
JWT_EXPIRES_IN=7d
CALENDAR_WEBHOOK_SECRET=<calendar-webhook-secret>

# Can share prod VAPID keys or generate new ones
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:ops@aidanlenahan.com

S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_BASE_URL=https://api-gem-dev.aidanlenahan.com/media/proxy
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<minio-access-key>
S3_SECRET_ACCESS_KEY=<minio-secret-key>
S3_BUCKET=gem-media-dev
S3_FORCE_PATH_STYLE=true

# User-facing notifications (OTP, welcome, event reminders, etc.)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@gem.aidanlenahan.com
SMTP_PASS=<noreply-smtp-password>
EMAIL_FROM=GEM Dev <noreply@gem.aidanlenahan.com>

# Developer alerts (error reports). Omit ALERT_SMTP_* to reuse the primary
# SMTP credentials (only works if your provider allows FROM != SMTP_USER).
ALERT_EMAIL_FROM=GEM Dev Alerts <devalert@gem.aidanlenahan.com>
ALERT_SMTP_USER=devalert@gem.aidanlenahan.com
ALERT_SMTP_PASS=<devalert-smtp-password>
ERROR_ALERT_EMAILS=aidanlenahan@gmail.com
