[Unit]
Description=GEM API (production)
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=15

[Service]
Type=simple
User=aidan
Group=devs
WorkingDirectory=/var/www/gem
EnvironmentFile=/etc/gem/gem-api.env
# Each environment runs its own build (dist-prod / dist-dev) so deploying one
# can never change the code the other runs. The Prisma client is bundled into
# that directory at build time by the deploy scripts — it is NOT
# re-copied here, since src/generated is shared and may belong to the other env.
ExecStart=/usr/bin/node /var/www/gem/apps/api/dist-prod/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/gem /tmp
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
