[Unit]
Description=GEM Web (production preview)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidan
Group=devs
WorkingDirectory=/var/www/gem
Environment=NODE_ENV=production
ExecStartPre=-/bin/bash -c "ss -tlnp 'sport = :4173' | grep -oP 'pid=\\K[0-9]+' | xargs -r kill -9 2>/dev/null; true"
ExecStart=/usr/bin/npm --workspace apps/web run preview -- --outDir dist-prod --host 127.0.0.1 --port 4173 --strictPort
Restart=always
RestartSec=3
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/gem /tmp
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
